# Start with bundled lessons. Add a verified database URL to enable persistence.
DATABASE_URL=""
# Session-pooler example: copy YOUR exact host/user from the Supabase dashboard.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/YOUR_DATABASE_NAME?schema=public&sslmode=require&connect_timeout=5&pool_timeout=5"
# The verified Vercel target is database postgres, schema public.
# Local development uses database postgrese, schema chemistry_development.
# Preserve existing postgrese/public and the unrelated postgres/planner data.
# Confirm each environment's actual target before running migrations; never reset.

# Empty = use the database when configured; bundled = explicit read-only sample preview.
CHEMISTRY_CONTENT_MODE=""
EXPECTED_SUPABASE_PROJECT_REF=""

NEXTAUTH_URL="http://localhost:3000"
# Only after registering this stable HTTPS preview origin's exact
# /api/auth/callback/google URL in Google Cloud. Preview Google is off otherwise.
GOOGLE_PREVIEW_ORIGIN=""
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISABLE_GOOGLE_LOGIN="false"

# Email verification / password recovery. Google login works independently.
# Verify a sender domain in Resend, then use a domain-restricted Sending key.
# Keep these server-only. Missing configuration disables email registration.
RESEND_API_KEY=""
EMAIL_FROM=""
# Use the actual public HTTPS site origin for production NEXTAUTH_URL above.
# Setup: docs/setup/transactional-email.md

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
# Legacy alternative supported: SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="chemistry-images"

# Billing is optional and is not activated by the study-site refactor.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
