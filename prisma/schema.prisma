generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ModuleType {
  PACK
  PLUGIN
}

enum EntitlementKind {
  MODULE_ACCESS
  FEATURE_FLAG
  CONTENT_ACCESS
}

enum GrantSource {
  SUBSCRIPTION
  PURCHASE
  MANUAL
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
  CANCELED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum EmailActionPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  SET_PASSWORD
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role Role @default(USER)

  // NextAuth tables
  accounts Account[]
  sessions Session[]

  // Billing + permissions
  subscriptions           Subscription[]
  purchases               Purchase[]
  entitlements            UserEntitlement[]
  modules                 UserModule[]
  progressEvents          Progress[]
  imageAssets             ImageAsset[]
  passwordCredential      PasswordCredential?
  emailActionTokens       EmailActionToken[]
  studyPreference         StudyPreference?
  readingPositions        ReadingPosition[]
  bookmarks               Bookmark[]
  personalNotes           PersonalNote[]
  contentDrafts           ContentDraft[]
  contentRevisions        ContentRevision[]
  emailChangeRequests     EmailChangeRequest[]
  accountDeletionRequests AccountDeletionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- NextAuth (Prisma Adapter) ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordCredential {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingRegistration {
  id             String   @id @default(cuid())
  emailCanonical String   @unique
  name           String
  passwordHash   String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
}

model EmailActionToken {
  id               String             @id @default(cuid())
  tokenHash        String             @unique
  registrationHash String?
  emailCanonical   String
  userId           String?
  purpose          EmailActionPurpose
  expiresAt        DateTime
  createdAt        DateTime           @default(now())
  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([emailCanonical, purpose])
  @@index([userId])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StudyPreference {
  userId     String   @id
  fontSize   Int      @default(18)
  lineHeight Float    @default(1.8)
  theme      String   @default("system")
  revision   Int      @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReadingPosition {
  id          String   @id @default(cuid())
  userId      String
  contentSlug String
  locale      String
  anchor      String?
  progress    Float    @default(0)
  revision    Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentSlug, locale])
  @@index([userId, updatedAt])
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  contentSlug String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentSlug])
  @@index([userId, createdAt])
}

model PersonalNote {
  id          String   @id @default(cuid())
  userId      String
  contentSlug String
  locale      String
  body        String   @db.Text
  revision    Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentSlug, locale])
  @@index([userId, updatedAt])
}

model ContentDraft {
  id          String   @id @default(cuid())
  userId      String
  contentId   String?
  draftKey    String
  payload     Json
  baseVersion Int?
  revision    Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@unique([userId, draftKey])
  @@index([userId, updatedAt])
}

model ContentRevision {
  id        String   @id @default(cuid())
  contentId String
  version   Int
  action    String   @default("save")
  snapshot  Json
  actorId   String?
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([contentId, version])
  @@index([contentId, createdAt])
}

model EmailChangeRequest {
  id             String    @id @default(cuid())
  userId         String
  previousEmail  String
  emailCanonical String
  newTokenHash   String    @unique
  oldTokenHash   String    @unique
  oldConfirmedAt DateTime?
  newConfirmedAt DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountDeletionRequest {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StorageDeletion {
  id        String   @id @default(cuid())
  path      String   @unique
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Plugin/Pack marketplace-ish modules ---
model Module {
  id          String     @id @default(cuid())
  key         String     @unique
  type        ModuleType
  title       String
  description String?

  // "上架/下架"
  isPublished Boolean @default(false)
  isActive    Boolean @default(true)

  contents     Content[]
  entitlements Entitlement[]
  userModules  UserModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A piece of content that can be gated by entitlements.
// MVP 可先把它当作 “章节记录”，与 MDX 文件 slug 对齐，后续可接 CMS。
model Content {
  id           String            @id @default(cuid())
  slug         String            @unique // e.g. thermodynamics/intro
  title        String
  module       String?
  body         String            @default("") @db.Text
  subjectSlug  String?
  chapterSlug  String?
  translations Json?
  order        Int               @default(0)
  isPublished  Boolean           @default(true)
  version      Int               @default(1)
  deletedAt    DateTime?
  revisions    ContentRevision[]
  drafts       ContentDraft[]

  // Where the content is sourced from (for MVP: a filesystem path).
  sourcePath String?

  // Free preview policy: allow previewRatio of the content for non-entitled users.
  previewRatio Float   @default(0.2)
  isPublic     Boolean @default(true)

  moduleId  String?
  moduleRel Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImageAsset {
  id          String   @id @default(cuid())
  filename    String
  url         String   @unique
  size        Int
  uploadedBy  String?
  purpose     String   @default("CONTENT")
  storagePath String?
  mimeType    String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([uploadedBy])
  @@index([createdAt])
}

// An entitlement is the atomic permission unit.
// Subscription tiers / one-time purchases / manual grants all map to entitlements.
model Entitlement {
  id   String          @id @default(cuid())
  key  String          @unique // e.g. module:thermo-pack, feature:mistake-book
  kind EntitlementKind

  // Optional pointers to what it unlocks.
  moduleId    String?
  module      Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  featureKey  String?
  contentSlug String?

  // Extra flexible data (e.g. "chapter preview 20%" overrides, tier metadata)
  metadata Json?

  users         UserEntitlement[]
  purchaseItems PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserEntitlement {
  id            String      @id @default(cuid())
  userId        String
  entitlementId String
  source        GrantSource
  expiresAt     DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlement Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, entitlementId])
  @@index([userId])
  @@index([entitlementId])
}

// User-installed/enabled modules (preference layer).
// Entitlement says "may use"; this says "is enabled".
model UserModule {
  id       String  @id @default(cuid())
  userId   String
  moduleId String
  enabled  Boolean @default(true)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

// --- Stripe billing records (skeleton) ---
model Subscription {
  id     String @id @default(cuid())
  userId String

  provider String @default("stripe")
  status   String // keep as string to match Stripe statuses

  stripeCustomerId     String?
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Purchase {
  id     String @id @default(cuid())
  userId String

  provider String         @default("stripe")
  status   PurchaseStatus @default(PENDING)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  items PurchaseItem[]
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PurchaseItem {
  id            String @id @default(cuid())
  purchaseId    String
  entitlementId String

  purchase    Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  entitlement Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, entitlementId])
}

// --- Minimal learning progress ---
model Progress {
  id          String         @id @default(cuid())
  userId      String
  contentSlug String // aligns with Content.slug and/or MDX route
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contentSlug])
  @@index([userId])
  @@index([contentSlug])
}
