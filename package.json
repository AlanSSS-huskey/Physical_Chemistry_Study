    "next-auth": "4.24.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
